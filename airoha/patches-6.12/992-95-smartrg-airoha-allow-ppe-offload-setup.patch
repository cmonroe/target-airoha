From: Hoang Viet Pham <hoang.pham@adtran.com>
Date: Wed, 01 Apr 2026 08:14:03 -0500
Subject: [PATCH] airoha: allow PPE offload setup from datapath API module

Export airoha_ppe_offload_setup() and add airoha_set_ppe_init_hook so
external modules can trigger PPE offload re-initialization after load.

Signed-off-by: Hoang Viet Pham <hoang.pham@adtran.com>
---
 drivers/net/ethernet/airoha/airoha_ppe.c  |    2 +-
 drivers/net/ethernet/airoha/arht_dp_api.c |   16 ++++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

Index: drivers/net/ethernet/airoha/airoha_ppe.c
===================================================================
--- a/drivers/net/ethernet/airoha/airoha_ppe.c	2026-03-30 02:41:06.684843342 -0500
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c	2026-03-30 02:35:43.326297988 -0500
@@ -1479,7 +1479,7 @@
 	return npu;
 }
 
-static int airoha_ppe_offload_setup(struct airoha_eth *eth)
+int airoha_ppe_offload_setup(struct airoha_eth *eth)
 {
 	struct airoha_npu *npu = airoha_ppe_npu_get(eth);
 	struct airoha_ppe *ppe = eth->ppe;
Index: drivers/net/ethernet/airoha/arht_dp_api.c 
===================================================================
--- a/drivers/net/ethernet/airoha/arht_dp_api.c	2026-03-30 02:38:31.198891021 -0500
+++ b/drivers/net/ethernet/airoha/arht_dp_api.c	2026-03-30 02:35:43.355389728 -0500
@@ -1832,6 +1832,10 @@
 EXPORT_SYMBOL(ra_sw_nat_hook_drop_packet);
 
 
+
+int (*airoha_set_ppe_init_hook)(void) = NULL;
+EXPORT_SYMBOL(airoha_set_ppe_init_hook);
+
 int (*ra_sw_nat_hook_clean_table) (void) = NULL;
 EXPORT_SYMBOL(ra_sw_nat_hook_clean_table);
 
@@ -11834,16 +11838,28 @@
 	return ret;
 
 }
+extern DEFINE_MUTEX(flow_offload_mutex);
+extern int airoha_ppe_offload_setup(struct airoha_eth *eth);
+int airoha_set_ppe_init(void)
+{
+	int ret;
+	mutex_lock(&flow_offload_mutex);
+	ret = airoha_ppe_offload_setup(glb_eth);
+	mutex_unlock(&flow_offload_mutex);
+	return ret;
 
+}
 void airoha_ppe_hook_init(void)
 {
 	rcu_assign_pointer(ra_sw_nat_hook_drop_packet, airoha_ppe_drop_packet_handler);
+	rcu_assign_pointer(airoha_set_ppe_init_hook, airoha_set_ppe_init);
 	return ;
 }
 
 void airoha_ppe_hook_exit(void)
 {
 	rcu_assign_pointer(ra_sw_nat_hook_drop_packet, NULL);
+	rcu_assign_pointer(airoha_set_ppe_init_hook, NULL);
 	return ;
 }
