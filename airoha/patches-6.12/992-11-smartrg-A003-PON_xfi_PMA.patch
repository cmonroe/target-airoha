+void __iomem* Get_Base(u32 base)
+{
+	printk("\ncommon_phy Get_Base:0x%x\n",base);	
+	switch (base){		
+						
+		case 0x1fa7a000:			
+			printk("\nserdes_common_phy->xfi_ana_pxp_phy_rg_base:0x%lx\n",(long unsigned)serdes_common_phy->xfi_ana_pxp_phy_rg_base);	
+			return serdes_common_phy->xfi_ana_pxp_phy_rg_base; 			
+			break;
+			
+		case 0x1fa7b000:			
+			printk("\nserdes_common_phy->xfi_pma_phy_rg_base:0x%lx\n",(long unsigned)serdes_common_phy->xfi_pma_phy_rg_base);	
+			return serdes_common_phy->xfi_pma_phy_rg_base; 			
+			break;
+
+		case 0x1fa8a000:
+			printk("\nserdes_common_phy->pon_ana_pxp_phy_rg_base:0x%lx\n",(long unsigned)serdes_common_phy->pon_ana_pxp_phy_rg_base);	
+			return serdes_common_phy->pon_ana_pxp_phy_rg_base; 			
+			break;
+			
+		case 0x1fa8b000:
+			printk("\nserdes_common_phy->pon_pma_phy_rg_base:0x%lx\n",(long unsigned)serdes_common_phy->pon_pma_phy_rg_base);	
+			return serdes_common_phy->pon_pma_phy_rg_base; 			
+			break;
+			
+		default :
+			printk("base addr not 10G Serdes Common PHY addr!ex: 0x1fa5a000, 0x1fa7a000, 0x1fa8a000\n");
+			return NULL;
+			break;	};
+}
+EXPORT_SYMBOL(Get_Base);
